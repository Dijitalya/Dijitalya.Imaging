<Project>

  <!-- Settings shared by every project of the repository. Change the target framework here only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The same source always gives the same assembly, so a CI build and a local build are comparable. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Ownership">
    <Authors>Dijitalya</Authors>
    <Company>Dijitalya</Company>
    <Product>Dijitalya.Imaging</Product>
    <Copyright>Copyright (c) 2026 Dijitalya</Copyright>
  </PropertyGroup>

</Project>
